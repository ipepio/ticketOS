# Environment variables
# Copy to .env and fill in required values.

# PostgreSQL connection
DATABASE_URL=postgresql://ticketos:ticketos@localhost:5432/ticketos

# Attachment storage
ATTACHMENT_STORAGE_ADAPTER=local
ATTACHMENT_LOCAL_DIR=./storage/attachments
# For S3/R2:
# ATTACHMENT_STORAGE_ADAPTER=s3
# ATTACHMENT_S3_BUCKET=ticketos
# ATTACHMENT_S3_REGION=auto
# ATTACHMENT_S3_ENDPOINT=
# ATTACHMENT_S3_ACCESS_KEY_ID=
# ATTACHMENT_S3_SECRET_ACCESS_KEY=
# ATTACHMENT_S3_FORCE_PATH_STYLE=false

# SMTP (outbound email)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# IMAP (inbound email, P0-07)
IMAP_HOST=localhost
IMAP_PORT=1143
IMAP_SECURE=false
IMAP_USER=
IMAP_PASSWORD=

# OIDC (P0-02)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# Session
SESSION_SECRET=change-me-in-production

# Server
HOST=0.0.0.0
PORT=3020
CORS_ORIGIN=http://localhost:5173

# Correlation ID header name
CORRELATION_ID_HEADER=X-Correlation-Id

# Log level: silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Reply-to token secret (signed, for P0-07 email correlation)
REPLY_TOKEN_SECRET=change-me-in-production
