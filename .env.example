# Environment variables
# Copy to .env and fill in required values.

# PostgreSQL connection
DATABASE_URL=postgresql://ticketos:ticketos@localhost:5432/ticketos

# Attachment storage
ATTACHMENT_STORAGE_ADAPTER=local
ATTACHMENT_LOCAL_DIR=./storage/attachments
# For S3/R2:
# ATTACHMENT_STORAGE_ADAPTER=s3
# ATTACHMENT_S3_BUCKET=ticketos
# ATTACHMENT_S3_REGION=auto
# ATTACHMENT_S3_ENDPOINT=
# ATTACHMENT_S3_ACCESS_KEY_ID=
# ATTACHMENT_S3_SECRET_ACCESS_KEY=
# ATTACHMENT_S3_FORCE_PATH_STYLE=false

# SMTP (outbound email)
# In development: MailHog runs on localhost:1025 (no auth)
# SMTP_FROM must match the sender address used in Magic Links
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ticketos.local

# Public portal URL — used in Magic Links and CORS
# In development: the Vite dev server port
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# IMAP (inbound email, P0-07)
IMAP_HOST=localhost
IMAP_PORT=1143
IMAP_SECURE=false
IMAP_USER=
IMAP_PASSWORD=

# OIDC (P0-02)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# Session (must be at least 32 characters)
SESSION_SECRET=change-me-in-production-to-a-long-random-string

# Server
HOST=0.0.0.0
PORT=3020

# Correlation ID header name
CORRELATION_ID_HEADER=X-Correlation-Id

# Log level: silent|fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Reply-to token secret (signed, for P0-07 email correlation)
REPLY_TOKEN_SECRET=change-me-in-production-to-a-long-random-string

# E2E test database (must be separate from development)
# E2E_DATABASE_URL=postgresql://ticketos:ticketos@localhost:15433/ticketos_e2e